{
  "name": "migratify",
  "version": "1.1.0",
  "author": "xitora.cc",
  "license": "Apache-2.0",
  "description": "Migratify - Spotify Account Migration Desktop Application",
  "homepage": "https://github.com/x2tora/Migratify",
  "repository": {
    "type": "git",
    "url": "https://github.com/x2tora/Migratify.git"
  },
  "bugs": {
    "url": "https://github.com/x2tora/Migratify/issues"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "start": "npm run build:electron && electron .",
    "dev:vite": "vite",
    "dev:electron": "tsc -p tsconfig.electron.json && electron . --dev",
    "dev": "concurrently -k \"vite --port 5173\" \"wait-on tcp:5173 && npm run dev:electron\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "vite build && npm run build:electron",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run pack && node scripts/build-custom-installer.cjs",
    "dist:installer": "npm run pack && node scripts/build-custom-installer.cjs",
    "dist:portable": "npm run build && electron-builder --win portable",
    "test": "jest"
  },
  "build": {
    "appId": "cc.xitora.migratify",
    "productName": "Migratify",
    "afterPack": "scripts/afterPack.cjs",
    "directories": {
      "output": "release-dist"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Migratify",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "gsap": "^3.15.1",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  }
}
